{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled meeting slot.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "description": "Tên của bạn." },
        "guide": { "type": "string", "description": "Hướng dẫn viên." },
        "question": { "type": "string", "description": "Bạn cần hỏi gì từ Sư Huynh?" },
        "date": { "type": "string", "description": "Date of the appointment (YYYY-MM-DD)." },
        "startTime": { "type": "string", "description": "Start time (HH:mm)." },
        "endTime": { "type": "string", "description": "End time (HH:mm)." },
        "password": { "type": "string", "description": "Mật mã bảo vệ lịch hẹn." },
        "status": { "type": "string", "enum": ["active", "cancelled"], "description": "Trạng thái lịch hẹn." },
        "cancellationReason": { "type": "string", "description": "Lý do hủy lịch từ Admin." },
        "cancelledAt": { "type": "string", "format": "date-time", "description": "When the booking was cancelled." },
        "cancelledByAdmin": { "type": "boolean", "description": "If the cancellation was done by admin." },
        "timeEditedByAdmin": { "type": "boolean", "description": "If the time was edited by admin." },
        "timeEditReason": { "type": "string", "description": "Reason for editing time." },
        "duration": { "type": "number", "description": "Duration in minutes." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the booking was made." }
      },
      "required": ["clientName", "guide", "question", "date", "startTime", "endTime", "password", "createdAt"]
    },
    "LockedSlot": {
      "title": "Locked Slot",
      "description": "A slot blocked by the admin.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "reason": { "type": "string" },
        "password": { "type": "string", "description": "Master password for override" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "slotDuration": { "type": "number", "default": 30 },
        "password": { "type": "string", "description": "Master password for override" },
        "announcement": { "type": "string", "description": "Thông báo quan trọng từ Admin hiển thị ở trang chủ." }
      }
    },
    "DayConfig": {
      "title": "Day Configuration",
      "description": "Specific settings for a particular day.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "morningActive": { "type": "boolean" },
        "afternoonActive": { "type": "boolean" },
        "duration": { "type": "number" }
      },
      "required": ["date", "morningActive", "afternoonActive", "duration"]
    },
    "CV": {
      "title": "CV Học Viên",
      "description": "Curriculum Vitae information for students.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "phoneLast4": { "type": "string", "description": "4 số cuối SĐT học viên" },
        "age": { "type": "string" },
        "address": { "type": "string" },
        "job": { "type": "string" },
        "target": { "type": "string" },
        "guideName": { "type": "string", "description": "Tên hướng dẫn viên" },
        "guidePhoneLast4": { "type": "string", "description": "4 số cuối SĐT của hướng dẫn viên" },
        "password": { "type": "string", "description": "Security PIN for the CV." },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "paymentImageUrl": { "type": "string", "description": "Lưu ảnh minh chứng chuyển khoản (Base64 hoặc URL)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "processedAt": { "type": "string", "format": "date-time" },
        "processedBy": { "type": "string", "description": "Người thực hiện phê duyệt/từ chối." },
        "appApproved": { "type": "boolean", "description": "Trạng thái phê duyệt cấp tài khoản app." },
        "appApprovedBy": { "type": "string", "description": "Người phê duyệt cấp tài khoản app." },
        "appApprovedAt": { "type": "string", "format": "date-time", "description": "Thời gian phê duyệt cấp tài khoản app." }
      },
      "required": ["fullName", "phone", "age", "guideName", "guidePhoneLast4", "password", "status", "createdAt"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of all appointments."
    },
    "/lockedSlots/{slotId}": {
      "schema": "LockedSlot",
      "description": "Slots blocked by admin."
    },
    "/settings/global": {
      "schema": "Settings",
      "description": "Global settings."
    },
    "/dayConfigs/{dateStr}": {
      "schema": "DayConfig",
      "description": "Day specific configurations."
    },
    "/cvs/{cvId}": {
      "schema": "CV",
      "description": "Student CV registrations."
    }
  }
}
