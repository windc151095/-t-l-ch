rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        request.auth.token.email == "congnguyen151095@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['clientName', 'guide', 'question', 'date', 'startTime', 'endTime', 'password', 'createdAt'])
        && data.keys().size() <= 12
        && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200
        && data.guide is string && data.guide.size() > 0 && data.guide.size() <= 200
        && data.question is string && data.question.size() > 0 && data.question.size() <= 1000
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startTime is string && data.startTime.matches('^\\d{2}:\\d{2}$')
        && data.endTime is string && data.endTime.matches('^\\d{2}:\\d{2}$')
        && data.password is string && data.password.size() >= 4 && data.password.size() <= 20
        && data.createdAt == request.time;
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Public Collections
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dayConfigs/{dateStr} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lockedSlots/{slotId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if isValidAppointment(incoming()) && isValidId(appointmentId);
      allow update: if (isAdmin() || incoming().password == existing().password)
        && (!incoming().keys().hasAny(['cancellationReason']) || (incoming().cancellationReason is string && incoming().cancellationReason.size() <= 500))
        && (!incoming().keys().hasAny(['cancelledByAdmin']) || incoming().cancelledByAdmin is bool);
      allow delete: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
