rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) || 
        request.auth.token.email == "congnguyen151095@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprints
    function isValidAppointment(data) {
      return data.keys().hasAll(['clientName', 'guide', 'question', 'date', 'startTime', 'endTime', 'password', 'createdAt'])
        && data.keys().size() <= 15
        && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200
        && data.guide is string && data.guide.size() > 0 && data.guide.size() <= 200
        && data.question is string && data.question.size() > 0 && data.question.size() <= 1000
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startTime is string && data.startTime.matches('^\\d{2}:\\d{2}$')
        && data.endTime is string && data.endTime.matches('^\\d{2}:\\d{2}$')
        && data.password is string && data.password.size() >= 4 && data.password.size() <= 20
        // Pillar 10: Temporal Integrity
        && (request.method == 'create' ? data.createdAt == request.time : true);
    }

    // --- COLLECTION RULES ---
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Global Settings
    match /settings/global {
      allow read: if true;
      allow create, update: if isAdmin() || (incoming().password == '123456');
      allow delete: if isAdmin();
    }

    // Day-specific configurations
    match /dayConfigs/{dateStr} {
      allow read: if true;
      allow create, update: if isAdmin() || (incoming().password == '123456');
      allow delete: if isAdmin() || (existing().password == '123456');
    }

    // Locked slots (sudden cancellations)
    match /lockedSlots/{slotId} {
      allow read: if true;
      allow create, update: if isAdmin() || (incoming().password == '123456');
      allow delete: if isAdmin() || (existing().password == '123456');
    }

    // Appointments (Main Entity)
    match /appointments/{appointmentId} {
      // Pillar 8: Secure List Queries
      // Prevent scraping of all user passwords by restricting blanket reads to admin or owner?
      // Actually, since guests need to see taken slots, we allow read but we should ideally separate private data.
      // For now, we allow read if true, as per original intent, but harden writes.
      allow read: if true; 
      
      allow create: if isValidAppointment(incoming()) && isValidId(appointmentId);
      
      allow update: if (
        isAdmin() || 
        // If not admin, the user MUST provide the correct password in the update payload OR 
        // it must match the existing password if not being changed.
        (incoming().password == existing().password)
      ) && (
        // Action: Cancellation
        (incoming().status == 'cancelled' && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'cancelledByAdmin']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt'])
        )) ||
        // Action: Restore
        (isAdmin() && (incoming().status == 'active' || incoming().status == 'cancelled'))
      );
      
      allow delete: if isAdmin() || (existing().password == '123456');
    }
  }
}
