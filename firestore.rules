rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) || 
        request.auth.token.email == "congnguyen151095@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprints
    function isValidAppointment(data) {
      return data.keys().hasAll(['clientName', 'guide', 'question', 'date', 'startTime', 'endTime', 'password', 'createdAt'])
        && data.keys().size() <= 20
        && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200
        && data.guide is string && data.guide.size() > 0 && data.guide.size() <= 200
        && data.question is string && data.question.size() > 0 && data.question.size() <= 1000
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startTime is string && data.startTime.matches('^\\d{2}:\\d{2}$')
        && data.endTime is string && data.endTime.matches('^\\d{2}:\\d{2}$')
        && data.password is string && data.password.size() >= 4 && data.password.size() <= 20
        // Pillar 10: Temporal Integrity
        && (request.method == 'create' ? data.createdAt == request.time : true);
    }

    function isValidCV(data) {
      return data.keys().hasAll(['fullName', 'age', 'guideName', 'password', 'status', 'createdAt'])
        && data.keys().size() <= 30
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 200
        && data.get('phone', '') is string
        && data.get('phoneLast4', '') is string
        && data.age is string && data.age.size() > 0 && data.age.size() <= 10
        && data.guideName is string && data.guideName.size() > 0 && data.guideName.size() <= 200
        && data.get('guidePhoneLast4', '') is string
        && data.password is string && data.password.size() >= 4 && data.password.size() <= 50
        && data.get('address', '') is string
        && data.get('job', '') is string
        && data.get('target', '') is string
        && data.get('paymentImageUrl', '') is string
        && data.get('processedBy', '') is string
        && (request.method == 'create' ? (data.status == 'pending' || data.status == 'approved') && data.createdAt == request.time : true)
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected');
    }

    function isEffectiveAdmin() {
      return isAdmin() || (incoming().get('adminAuth', '') == '123456');
    }

    // --- COLLECTION RULES ---
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Global Settings
    match /settings/global {
      allow read: if true;
      allow create, update: if isAdmin() || (incoming().password == '123456');
      allow delete: if isAdmin();
    }

    // Day-specific configurations
    match /dayConfigs/{dateStr} {
      allow read: if true;
      allow create, update: if isAdmin() || (incoming().password == '123456');
      allow delete: if isAdmin() || (existing().password == '123456');
    }

    // Locked slots (sudden cancellations)
    match /lockedSlots/{slotId} {
      allow read: if true;
      allow create, update: if isAdmin() || (incoming().password == '123456');
      allow delete: if isAdmin() || (existing().password == '123456');
    }

    // Appointments (Main Entity)
    match /appointments/{appointmentId} {
      allow read: if true; 
      
      allow create: if isValidAppointment(incoming()) && isValidId(appointmentId);
      
      allow update: if (
        isEffectiveAdmin() || 
        (incoming().password == existing().password)
      ) && (
        // Action: Cancellation
        (incoming().status == 'cancelled' && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'cancelledByAdmin', 'adminAuth']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt', 'adminAuth'])
        )) ||
        // Action: Edit Time
        (incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startTime', 'endTime', 'timeEditedByAdmin', 'timeEditReason', 'adminAuth', 'password'])) ||
        // Action: Restore
        (isEffectiveAdmin() && (incoming().status == 'active' || incoming().status == 'cancelled'))
      );
      
      allow delete: if isAdmin() || (existing().get('adminAuth', '') == '123456');
    }

    // CVs Collection
    match /cvs/{cvId} {
      // Allow list and get for everyone so they can search by PIN or view as admin (demo mode)
      allow read: if true;
      
      allow create: if isValidCV(incoming()) && isValidId(cvId);
      allow update: if (
        isAdmin() || 
        (incoming().get('adminAuth', '') == '123456') || 
        (existing().password != null && incoming().password == existing().password)
      );
      allow delete: if isAdmin() || true; // In demo mode, allow deletion for simplify
    }
    // Courses Collection
    match /courses/{courseId} {
      allow read, write: if true;
    }

  }
}
